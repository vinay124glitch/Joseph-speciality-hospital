# Joseph Speciality Hospital — Environment Variables
#
# These Supabase variables are pre-populated in the Bolt environment.
# Copy this file to ".env" if running locally and fill in your own values.

# Supabase project URL
VITE_SUPABASE_URL=your_supabase_project_url

# Supabase anon (public) key — safe for frontend use
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# ───────────────────────────────────────────────
# The variables below are server-side only and
# are NOT needed by the frontend. They are already
# configured in the hosted environment.
# ───────────────────────────────────────────────

# Supabase service role key — server-side only, never expose to the client
# SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Supabase database connection string — server-side only
# SUPABASE_DB_URL=your_database_url
